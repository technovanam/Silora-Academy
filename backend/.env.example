# ---------------------------------------------------------------------------
# Silora Academy backend – copy to .env and fill in
# ---------------------------------------------------------------------------
PORT=5000

# Website forms + portal emails – SMTP from the academy's own mailbox (Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@siloraacademy.com
SMTP_PASS=
MAIL_FROM="Silora Academy <info@siloraacademy.com>"
MAIL_USER=info@siloraacademy.com
# PORTAL_MAIL_FROM="Silora Academy <portal@siloraacademy.com>"

# ---- Portal: Firebase -----------------------------------------------------
# true = local Firebase Emulator Suite (run ../start-emulators.sh first)
USE_FIREBASE_EMULATORS=true
FIREBASE_PROJECT_ID=demo-silora
# For a real Firebase project (USE_FIREBASE_EMULATORS=false):
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# FIREBASE_WEB_API_KEY=AIza...            (Project settings → General → Web API key)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Where the site and the API are reachable (used in emails and file links)
PORTAL_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000
APP_TIMEZONE=Asia/Kolkata

# Signs short-lived file links – use a long random value in production
FILE_TOKEN_SECRET=change-me-to-a-long-random-string
FILE_TOKEN_TTL_SEC=900
MAX_MATERIAL_MB=50
# Files sent in Messages (teacher <-> student): max size, and days before they are deleted
MAX_MESSAGE_FILE_MB=25
MESSAGE_FILE_RETENTION_DAYS=7

# Optional malware scanning with ClamAV (docker run -p 3310:3310 clamav/clamav)
CLAMD_HOST=
CLAMD_PORT=3310

# Most students in one class
MAX_CLASS_SIZE=30
# Class recordings (made in the teacher's browser, stored in Firebase Storage):
# days kept after the class, and the storage limit after which no new recording starts
RECORDING_RETENTION_DAYS=30
RECORDING_STORAGE_CAP_GB=4
# Space in each student's "My recordings" library
STUDENT_RECORDING_QUOTA_GB=1

# Scheduled jobs: reminders, scheduled publishing, retries, cleanup, backups
ENABLE_JOBS=true

# Login aliases: email at the left domain signs into the account at the right one
EMAIL_DOMAIN_ALIASES=siloraacademy.in=siloraacademy.com
